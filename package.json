        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.4.6",
        "@zumer/snapdom": "^1.9.5",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.9.0",
        "happy-dom": "^18.0.0",
        "tailwindcss": "^4.1.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.66.0",
        "vite": "^7.0.0",
        "vitest": "^3.2.0",
        "vue": "^3.5.0",
        "vue-tsc": "^3.0.0"
    }
